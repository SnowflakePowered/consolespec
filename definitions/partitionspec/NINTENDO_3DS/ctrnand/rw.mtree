#mtree
# Nintendo 3DS ctrnand:/rw, identical across every firmware
# title content sizes and digests are those Nintendo signed into each TMD
# console-unique files carry name and size only, never a digest
. type=dir
./shared type=dir
./sys type=dir
./sys/LocalFriendCodeSeed_B type=file size=272
./sys/SecureInfo_A type=file size=273
./sys/rand_seed type=file size=64
