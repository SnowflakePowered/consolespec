#mtree
# Nintendo DSi TWL_MAIN:/shared2, identical across every firmware
# save files a fresh install leaves blank carry a name only: their
# size and contents change as soon as the title is used
# console-specific files carry name and size only, never a digest
. type=dir
./0000 type=file size=2097152
./launcher type=dir
./launcher/wrap.bin type=file size=16384
