#mtree
# Nintendo DSi TWL_MAIN:/sys as installed by 5 firmwares: 1.4.2C, 1.4.3C, 1.4.5C, 1.4.6C, 1.4C
# save files a fresh install leaves blank carry a name only: their
# size and contents change as soon as the title is used
# console-specific files carry name and size only, never a digest
. type=dir
./HWID.sgn type=file size=256
./HWINFO_N.dat type=file size=16384
./HWINFO_S.dat type=file size=16384
./TWLFontTable.dat type=file size=581664 md5=ecaef8db63595e826ad3591265ec8436 sha1=5170aff7e9766baadbbf2943c41f5634e82aaf2d sha256=42de5bc0513d6246b2fb678316da15677a10e3f263c1d9b3cf9f552860f16aab
./cert.sys type=file size=3904
./dev.kp type=file size=446
./log type=dir
./log/product.log type=file
./log/shop.log type=file size=32
./log/sysmenu.log type=file size=16384
