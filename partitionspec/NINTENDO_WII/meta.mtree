#mtree
# Nintendo Wii meta partition skeleton
# title.met blobs written by the factory install disc, not by any update
# console state, not update content: paths only, never a digest,
# and sizes only where a source fixes them
. type=dir
./meta type=dir
./meta/00000001 type=dir
./meta/00000001/00000002 type=dir
./meta/00000001/00000002/title.met type=file
./meta/00000001/00000004 type=dir
./meta/00000001/00000004/title.met type=file
./meta/00000001/00000009 type=dir
./meta/00000001/00000009/title.met type=file
