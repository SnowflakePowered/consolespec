#mtree
# Nintendo Wii system menu 2.0U installed NAND state (shared1)
# names are allocated in install order, so no .app can be given a size or digest; content.map is 28 bytes per content
. type=dir
./shared1 type=dir
./shared1/00000000.app type=file
./shared1/00000001.app type=file
./shared1/00000002.app type=file
./shared1/00000003.app type=file
./shared1/00000004.app type=file
./shared1/00000005.app type=file
./shared1/00000006.app type=file
./shared1/content.map type=file size=196
