#mtree
# Nintendo Wii system menu installed NAND state (shared1)
# names are allocated in install order, so no .app can be given a size or digest; content.map is 28 bytes per content
# as installed by 2 firmwares: 2.2E, 2.2U
. type=dir
./00000000.app type=file
./00000001.app type=file
./00000002.app type=file
./00000003.app type=file
./00000004.app type=file
./00000005.app type=file
./00000006.app type=file
./00000007.app type=file
./00000008.app type=file
./00000009.app type=file
./0000000a.app type=file
./0000000b.app type=file
./0000000c.app type=file
./0000000d.app type=file
./0000000e.app type=file
./0000000f.app type=file
./00000010.app type=file
./00000011.app type=file
./00000012.app type=file
./00000013.app type=file
./00000014.app type=file
./content.map type=file size=588
