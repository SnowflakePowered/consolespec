#mtree
# Nintendo Wii system menu installed NAND state (shared1)
# names are allocated in install order, so no .app can be given a size or digest; content.map is 28 bytes per content
# as installed by 3 firmwares: 3.0J, 3.0U, 3.5K
. type=dir
./00000000.app type=file
./00000001.app type=file
./00000002.app type=file
./00000003.app type=file
