#mtree
# Nintendo Wii shared2 partition skeleton
# setup data and logs for WiiConnect24, Miis and the factory test line
# console state, not update content: paths only, never a digest,
# and sizes only where a source fixes them
. type=dir
./DIAG type=dir
./DWC_AUTHDATA type=file
./FaceLib type=dir
./aging type=dir
./cntcache.txt type=file
./diag type=dir
./ec type=dir
./ec/shopsetu.log type=file
./ec/sync type=dir
./expired type=file
./menu type=dir
./menu/FaceLib type=dir
./menu/FaceLib/RFL_DB.dat type=file
./menu/vc type=dir
./menu/vc/settings.sav type=file
./succession type=dir
./succession/shop.log type=file
./succession/transfer.id type=file
./sys type=dir
./sys/NANDBOOTINFO type=file size=4128
./sys/SYSCONF type=file size=16384
./sys/flags.dat type=file
./sys/net type=dir
./sys/net/02 type=dir
./sys/net/02/config.dat type=file
./sys/net/dhcp.dat type=file
./test type=dir
./test/testlog.txt type=file
./test2 type=dir
./test2/dvderror.dat type=file
./test2/nanderr.log type=file
./title type=dir
./wc24 type=dir
./wc24/dlcnt.bin type=file
./wc24/mbox type=dir
./wc24/mbox/wc24recv.ctl type=file size=32768
./wc24/mbox/wc24recv.mbx type=file
./wc24/mbox/wc24send.ctl type=file size=16384
./wc24/mbox/wc24send.mbx type=file
./wc24/misc.bin type=file size=1024
./wc24/nwc24dl.bin type=file size=63488
./wc24/nwc24fl.bin type=file size=32864
./wc24/nwc24fls.bin type=file size=12800
./wc24/nwc24msg.cbk type=file size=1024
./wc24/nwc24msg.cfg type=file size=1024
