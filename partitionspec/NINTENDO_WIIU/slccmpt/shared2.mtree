#mtree
# Nintendo Wii U vWii SLCCMPT shared2 partition skeleton
# setup data for WiiConnect24, Miis and the Wii U compatibility layer
# console state, not update content: paths only, never a digest,
# and sizes only where a source fixes them
. type=dir
./menu type=dir
./menu/FaceLib type=dir
./menu/FaceLib/RFL_DB.dat type=file size=779968
./menu/vc type=dir
./menu/vc/settings.sav type=file size=32
./succession type=dir
./succession/transfer.id type=file size=32
./sys type=dir
./sys/SYSCONF type=file size=16384
./sys/compat type=dir
./sys/flags.dat type=file size=32
./sys/net type=dir
./sys/net/02 type=dir
./sys/net/02/config.dat type=file size=7004
./sys/net/dhcp.dat type=file size=96
./test2 type=dir
./test2/nanderr.log type=file size=16384
./wc24 type=dir
./wc24/mbox type=dir
./wc24/mbox/wc24recv.ctl type=file size=32768
./wc24/mbox/wc24recv.mbx type=file size=7340032
./wc24/mbox/wc24send.ctl type=file size=16384
./wc24/mbox/wc24send.mbx type=file size=2097152
./wc24/misc.bin type=file size=1024
./wc24/nwc24dl.bin type=file size=63488
./wc24/nwc24fl.bin type=file size=32864
./wc24/nwc24fls.bin type=file size=12800
./wc24/nwc24msg.cbk type=file size=1024
./wc24/nwc24msg.cfg type=file size=1024
